# Copie ce fichier en « .env » puis remplis les valeurs.

# Adresse publique du site, sans « / » à la fin (liens des e-mails, retour de Stripe).
BASE_URL=http://localhost:3000
PORT=3000
# Mets « production » une fois en ligne (cookies sécurisés, HTTPS strict).
NODE_ENV=development

# Mot de passe de l'espace studio (/admin). Choisis-en un long.
ADMIN_PASSWORD=change-moi
# Facultatif : chaîne aléatoire pour signer la connexion admin.
SESSION_SECRET=

# Stripe : https://dashboard.stripe.com/apikeys — laisse vide pour le mode démo.
STRIPE_SECRET_KEY=
# Secret du webhook (Développeurs > Webhooks, ou affiché par « stripe listen »).
STRIPE_WEBHOOK_SECRET=

# E-mails (SMTP). Laisse SMTP_HOST vide : les e-mails sont copiés dans data/outbox/.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Phoenix Empire <reservations@phoenix-empire.fr>"
# Adresse qui reçoit les nouvelles réservations (par défaut : l'e-mail du studio).
STUDIO_NOTIFY_EMAIL=

# Dossier de la base de données (par défaut : ./data). Doit être un disque persistant en ligne.
DATA_DIR=
